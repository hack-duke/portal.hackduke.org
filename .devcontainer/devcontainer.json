{
  "name": "Portal Dev",
  "context": ".",
  "dockerFile": "Dockerfile",
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/python": {
      "version": "3.12",
      "installTools": false
    },
    "ghcr.io/devcontainers-extra/features/poetry:2": {
      "version": "1.8.3"
    },
    "ghcr.io/roul/devcontainer-features/vault:1": {}
  },
  "containerEnv": {
    "POETRY_VIRTUALENVS_IN_PROJECT": "true"
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [3000],
  "runArgs": ["--network=host", "--dns-search=tail9e7885.ts.net"],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode-remote.remote-containers",
        "ms-azuretools.vscode-docker",
        "ms-vscode.makefile-tools",
        "esbenp.prettier-vscode",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/portal-backend-python/.venv/bin/python",
        "python-envs.pythonProjects": [
          {
            "path": "./portal-backend-python",
            "envManager": "ms-python.python:poetry",
            "packageManager": "ms-python.python:poetry"
          }
        ],
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },
  "postCreateCommand": "npm install"
  // "mounts": [
  //   // Experimental, mount ssh and gitconfig from host machine
  //   "type=bind,source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/vscode/.ssh",
  //   "type=bind,source=${localEnv:HOME}${localEnv:USERPROFILE}/.gitconfig,target=/home/vscode/.gitconfig"
  // ]
}
